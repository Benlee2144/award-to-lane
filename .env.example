# Copy to .env and fill in. Never commit .env.
APOLLO_API_KEY=
USDA_MARS_API_KEY=

# SAM.gov Entity Management API (plugins.sam_gov): the "Public API Key" from your SAM.gov profile > Account Details
SAM_GOV_API_KEY=

# Optional Socrata app token for the FMCSA fleet plug-in (plugins.fmcsa); free at https://data.transportation.gov/profile/edit/developer_settings
SOCRATA_APP_TOKEN=
